{
  "version": "v7",
  "meta": {
    "description": "Component inference, slot detection, and fallback rules for copy generation",
    "anti_hallucination_policy": {
      "inference_principle": "Use heuristics to IDENTIFY the right component/slot, then apply that component's RULES to generate copy",
      "fallback_principle": "When uncertain, apply the most conservative (strictest) rules",
      "never_assume": "Don't assume market, component, or context — ask for clarification if ambiguous"
    }
  },
